<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests de la logique ZIP / settings / liens / sortie : sans Revit, exécutables sous Linux. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\Egis.Revit.SystemFilter.DesignAutomation.Io\Egis.Revit.SystemFilter.DesignAutomation.Io.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Logique de fusion de parentIds (Core, sans API Revit) compilée ici pour être testée sous Linux. -->
    <Compile Include="..\Egis.Revit.SystemFilter.Core\Services\ParentIdMerge.cs" Link="Core\ParentIdMerge.cs" />
    <Compile Include="..\Egis.Revit.SystemFilter.Core\Services\BaseEquipmentCheck.cs" Link="Core\BaseEquipmentCheck.cs" />
    <Compile Include="..\Egis.Revit.SystemFilter.Core\Services\BaseEquipmentFallback.cs" Link="Core\BaseEquipmentFallback.cs" />
    <Compile Include="..\Egis.Revit.SystemFilter.Core\Services\LevelChoice.cs" Link="Core\LevelChoice.cs" />
    <Compile Include="..\Egis.Revit.SystemFilter.Core\Services\RoomChoice.cs" Link="Core\RoomChoice.cs" />
    <Compile Include="..\Egis.Revit.SystemFilter.Core\Models\Inventory\RoomRecord.cs" Link="Core\RoomRecord.cs" />
    <Compile Include="..\Egis.Revit.SystemFilter.Core\Models\Inventory\NetworkElementRecord.cs" Link="Core\NetworkElementRecord.cs" />
    <Compile Include="..\Egis.Revit.SystemFilter.Core\Models\Inventory\NetworkDomain.cs" Link="Core\NetworkDomain.cs" />
    <Compile Include="..\Egis.Revit.SystemFilter.Core\Models\Inventory\SystemRecord.cs" Link="Core\SystemRecord.cs" />
    <None Include="..\Packaging\definitions\**\activity.json" LinkBase="Data\definitions" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
