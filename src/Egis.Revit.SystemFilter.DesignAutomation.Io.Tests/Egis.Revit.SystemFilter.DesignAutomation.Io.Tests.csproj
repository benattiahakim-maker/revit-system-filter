<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests de la logique ZIP / settings / liens / sortie : sans Revit, exécutables sous Linux. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\Egis.Revit.SystemFilter.DesignAutomation.Io\Egis.Revit.SystemFilter.DesignAutomation.Io.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\Packaging\definitions\**\activity.json" LinkBase="Data\definitions" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
