<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <RootNamespace>Egis.Revit.SystemFilter.DesignAutomation</RootNamespace>
    <AssemblyName>Egis.Revit.SystemFilter.DesignAutomation</AssemblyName>
    <!-- Core référence WindowsBase (via RevitAPI) : on active le framework desktop. -->
    <UseWPF>true</UseWPF>
    <UseRevitApi>true</UseRevitApi>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Egis.Revit.SystemFilter.Core\Egis.Revit.SystemFilter.Core.csproj" />
    <!-- Logique ZIP / settings / liens / sortie, sans Revit (testée sous Linux). Copiée dans le bundle. -->
    <ProjectReference Include="..\Egis.Revit.SystemFilter.DesignAutomation.Io\Egis.Revit.SystemFilter.DesignAutomation.Io.csproj" />
  </ItemGroup>

  <!--
    DesignAutomationBridge.dll est EMBARQUÉ dans le bundle (il déclenche
    DesignAutomationReadyEvent). On le laisse donc être copié en sortie.
    L'API Revit (Nice3point) reste en référence seule (fournie par le moteur).
    Version alignée sur la version Revit de chaque cible.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="2026.0.0" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="2027.0.0" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    Projet bibliothèque : NuGet ne copie pas ses DLL en sortie. On copie donc
    explicitement DesignAutomationBridge.dll (seule DLL du package à embarquer)
    depuis le package restauré, chemin résolu par GeneratePathProperty.
    Seulement dans les builds par cible (pas dans le build "externe" multi-cible).
  -->
  <Target Name="CopyDesignAutomationBridge" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <_DaBridge Include="$(PkgAutodesk_Forge_DesignAutomation_Revit)/lib/*/DesignAutomationBridge.dll" />
    </ItemGroup>
    <Error Condition="'@(_DaBridge)' == ''" Text="DesignAutomationBridge.dll introuvable dans le package Autodesk.Forge.DesignAutomation.Revit ($(PkgAutodesk_Forge_DesignAutomation_Revit))." />
    <Copy SourceFiles="@(_DaBridge)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
