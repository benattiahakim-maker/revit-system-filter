<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <RootNamespace>Egis.Revit.SystemFilter.DesignAutomation</RootNamespace>
    <AssemblyName>Egis.Revit.SystemFilter.DesignAutomation</AssemblyName>
    <!-- Core référence WindowsBase (via RevitAPI) : on active le framework desktop. -->
    <UseWPF>true</UseWPF>
    <UseRevitApi>true</UseRevitApi>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Egis.Revit.SystemFilter.Core\Egis.Revit.SystemFilter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Egis.Revit.SystemFilter.DesignAutomation.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    DesignAutomationBridge est fourni par le moteur Design Automation à l'exécution.
    On le référence en compile-only (ExcludeAssets=runtime) pour ne pas l'embarquer
    dans le bundle. Version alignée sur la version Revit de chaque cible.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="2026.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="2027.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
