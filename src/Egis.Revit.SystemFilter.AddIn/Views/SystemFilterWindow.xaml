<Window x:Class="Egis.Revit.SystemFilter.AddIn.Views.SystemFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vérification systèmes CVCD"
        Height="640" Width="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="520" MinWidth="720"
        Background="#F3F4F6"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0E7C86" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0A5E66" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <Style x:Key="CheckListBox" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="4,2" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Vérification des systèmes CVCD"
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Trois listes -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           Text="Types de système" />
                <ListBox Style="{StaticResource CheckListBox}" ItemsSource="{Binding SystemTypes}" />
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           Text="Nom de matériel" />
                <ListBox Style="{StaticResource CheckListBox}" ItemsSource="{Binding Materials}" />
            </DockPanel>

            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           Text="Worksets PSY" />
                <ListBox Style="{StaticResource CheckListBox}" ItemsSource="{Binding Worksets}"
                         IsEnabled="{Binding HasWorksets}" />
            </DockPanel>
        </Grid>

        <!-- Option worksets -->
        <CheckBox Grid.Row="2" Margin="2,12,0,4"
                  Content="Conserver visibles les worksets PSY sélectionnés"
                  IsChecked="{Binding IncludePsyWorksets, Mode=TwoWay}"
                  IsEnabled="{Binding HasWorksets}" />

        <!-- Nom de vue + actions -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           Text="Nom de la vue à enregistrer" />
                <TextBox Height="40" VerticalContentAlignment="Center" Padding="8,0"
                         BorderBrush="#D1D5DB"
                         Text="{Binding ViewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <Button Grid.Column="2" Content="Filtrer" VerticalAlignment="Bottom"
                    Style="{StaticResource PrimaryButton}" Command="{Binding FilterCommand}" />

            <Button Grid.Column="4" Content="Enregistrer la vue" VerticalAlignment="Bottom"
                    Style="{StaticResource PrimaryButton}" Command="{Binding SaveViewCommand}" />
        </Grid>

        <!-- Barre d'état -->
        <Border Grid.Row="4" Margin="0,14,0,0" Background="#E5E7EB" CornerRadius="4" Padding="10,8">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#111827" />
        </Border>
    </Grid>
</Window>
