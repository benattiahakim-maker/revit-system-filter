{
  "id": "SystemsInventory_R2026",
  "engine": "Autodesk.Revit+2026",
  "commandLine": [
    "$(engine.path)\\\\revitcoreconsole.exe /al \"$(appbundles[EgisSystemFilter_R2026].path)\""
  ],
  "appbundles": [
    "{{NICKNAME}}.EgisSystemFilter_R2026+{{APPBUNDLE_ALIAS}}"
  ],
  "parameters": {
    "inputZip": {
      "zip": true,
      "ondemand": false,
      "verb": "get",
      "description": "ZIP : maquette principale (.rvt) et ses liens, en arborescence relative",
      "required": true,
      "localName": "input"
    },
    "settings": {
      "zip": false,
      "ondemand": false,
      "verb": "get",
      "description": "Réglages facultatifs (settings.json : mainModelPath, outputFileName, includeDuctSystems, includePipingSystems)",
      "required": false,
      "localName": "settings.json"
    },
    "result": {
      "zip": true,
      "ondemand": false,
      "verb": "put",
      "description": "output.zip : systems-inventory.json (format 1.0) et run.log",
      "required": true,
      "localName": "result"
    }
  },
  "description": "Revit System Filter : export de l'inventaire des systèmes depuis un ZIP (Revit 2026)"
}
