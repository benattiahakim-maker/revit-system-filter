# Normalise les fins de ligne
* text=auto

# Fichiers sources en LF
*.cs       text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.sln      text eol=crlf
*.xaml     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.addin    text eol=lf

# Binaires
*.jpg      binary
*.png      binary
*.dll      binary
