<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests de DaManager hors WPF (ViewModels, plans, options) sur un serveur APS simulé : aucun réseau (EGR-19). -->
  <PropertyGroup>
    <TargetFramework>$(CoreTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Egis.Revit.SystemFilter.DaManager.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Egis.Revit.SystemFilter.DaManager.Core\Egis.Revit.SystemFilter.DaManager.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Doublures partagées avec les tests de la bibliothèque APS (ZIP conforme, dossier temporaire). -->
    <Compile Include="..\Egis.Revit.SystemFilter.Aps.Tests\Support.cs" Link="Shared\Support.cs" />
    <Compile Include="..\Egis.Revit.SystemFilter.Aps.Tests\FakeHttpHandler.cs" Link="Shared\FakeHttpHandler.cs" />
    <None Include="..\..\src\Packaging\definitions\**\*.json" LinkBase="Data\definitions" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
