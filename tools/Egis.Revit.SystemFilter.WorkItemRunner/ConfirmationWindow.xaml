<Window x:Class="Egis.Revit.SystemFilter.WorkItemRunner.App.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmer l'opération" Width="760" Height="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" x:Name="TitleText" Style="{StaticResource Heading}" />
    <TextBlock DockPanel.Dock="Top" x:Name="WarningText" Visibility="Collapsed" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Opération irréversible. Saisir CONFIRMER pour continuer." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBox x:Name="TypedConfirmation" Width="160" Visibility="Collapsed" TextChanged="OnTypedConfirmationChanged" />
      <Button Content="Annuler" Style="{StaticResource Secondary}" IsCancel="True" Click="OnCancel" />
      <Button x:Name="ConfirmButton" Content="Confirmer" Click="OnConfirm" />
    </StackPanel>
    <Border Style="{StaticResource Card}">
      <TextBox x:Name="PlanText" IsReadOnly="True" FontFamily="Consolas" BorderThickness="0" TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </Border>
  </DockPanel>
</Window>
