<Project>

  <!--
    Propriétés partagées par tous les projets de la solution.
    Le multi-ciblage adresse deux versions de Revit :
      - net8.0-windows  -> Revit 2026 (.NET 8)
      - net10.0-windows -> Revit 2027 (.NET 10)
    L'API Revit est référencée via les packages NuGet Nice3point (assemblages de
    référence, non copiés en sortie) : le build fonctionne sans Revit installé,
    y compris sur un runner CI.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>Egis</Company>
    <Authors>Egis Bâtiment - Pôle BIM</Authors>
    <Product>Revit System Filter</Product>
    <Version>2.0.0</Version>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Résolution de la version Revit et du package API en fonction du Target Framework. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <RevitVersion>2026</RevitVersion>
    <RevitApiPackageVersion>2026.0.4</RevitApiPackageVersion>
    <DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <RevitVersion>2027</RevitVersion>
    <RevitApiPackageVersion>2027.2.0</RevitApiPackageVersion>
    <DefineConstants>$(DefineConstants);REVIT2027</DefineConstants>
  </PropertyGroup>

  <!-- Références de l'API Revit, activées par <UseRevitApi>true</UseRevitApi> dans chaque projet. -->
  <ItemGroup Condition="'$(UseRevitApi)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" />
  </ItemGroup>

</Project>
